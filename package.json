{
  "name": "wangeci-profile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:seed": "node --env-file=.env.local --env-file=.env.development.local prisma/seed.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",

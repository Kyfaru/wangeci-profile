    "@preline/pin-input": "^5.1.0",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^11.12.0",
    "@upstash/qstash": "^2.12.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "better-auth": "^1.7.25",
    "canvas-confetti": "^1.9.4",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "preline": "^5.1.0",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.1",

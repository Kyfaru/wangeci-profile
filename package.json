    "@preline/pin-input": "^5.0.0",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.71.0",
    "@tanstack/react-query": "^5.102.6",
    "@upstash/qstash": "^2.12.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.2",
    "motion": "^13.4.2",
    "next": "16.3.1",
    "preline": "^5.0.0",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.24.0",

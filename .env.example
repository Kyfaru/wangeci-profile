# Copy this file to .env.local and fill in real values.
# Real credentials come from the project owner — none of the placeholders
# below are valid secrets. See lib/env.ts for validation rules.

NODE_ENV=development

# Postgres (Neon) — DATABASE_URL is pooled, DIRECT_URL bypasses the pooler
# for migrations.
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:3000

# Next.js Server Actions payload encryption (min 32 chars)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-random-32-plus-character-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=replace-with-paystack-webhook-secret

# Cloudflare R2
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_PUBLIC=pub-replace-me.r2.dev
R2_BUCKET_PROTECTED=wangeci-protected

# Resend (transactional email)
RESEND_API_KEY=re_replace_me
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret

# Africa's Talking (SMS)
AT_USERNAME=sandbox
AT_API_KEY=replace-with-at-api-key
AT_SENDER_ID=WANGECI

# ElevenLabs (audiobook narration/voice)
ELEVENLABS_API_KEY=sk_replace_me

# Sentry (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Comma-separated list of admin emails allowed into the admin panel
ADMIN_EMAIL_ALLOWLIST=admin@example.com

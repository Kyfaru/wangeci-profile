# Copy this file to .env.local and fill in real values. Names only, never commit secrets.
# lib/env.ts validates these; production refuses to boot if a required one is missing.

NODE_ENV=

# Site identity. NEXT_PUBLIC_SITE_ENV is "production" ONLY on the real domain; anything else is noindex.
# With NODE_ENV=production the strict checks (Upstash, QStash, Daraja, Turnstile, CRON_SECRET) apply
# unless this is exactly "staging". Unset = strict. Set it before the build (it is baked in).
NEXT_PUBLIC_SITE_ENV=
NEXT_PUBLIC_SITE_URL=

# Postgres (Neon): DATABASE_URL is the pooled string, DIRECT_URL bypasses the pooler for migrations.
DATABASE_URL=
DIRECT_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Extra allowed origins, comma-separated (e.g. the staging domain). Optional.
TRUSTED_ORIGINS=

# Next.js Server Actions payload encryption (min 32 chars)
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=
R2_BUCKET_PROTECTED=

# Resend (transactional email)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Africa's Talking (SMS). AT_WEBHOOK_TOKEN is the secret in the delivery-report callback URL (?token=).
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_WEBHOOK_TOKEN=

# Upstash Redis (rate limits). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Comma-separated emails allowed to become the first owner
ADMIN_EMAIL_ALLOWLIST=

# M-Pesa (Safaricom Daraja STK push). DARAJA_ENV is "sandbox" or "production".
DARAJA_ENV=
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=
DARAJA_CALLBACK_TOKEN=

# Secret for scheduled jobs (/api/cron/*). Required in production.
CRON_SECRET=

# Contact form and urgent alerts go to this mailbox
CONTACT_INBOX_EMAIL=

# Cloudflare Turnstile (bot check on code requests). Required in production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash QStash (queue that sends one-time codes). Required in production; locally codes are sent directly.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Google sign-in (optional until the OAuth client exists)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Processing fee at checkout in percent (0 = none)
CHECKOUT_FEE_PERCENT=0

# Umami analytics (hosted). Absent = no tracking script and no admin analytics cards.
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_API_URL=
UMAMI_SCRIPT_URL=

# Chatwoot live chat. Absent = no widget. The webhook (/api/webhooks/chatwoot) needs the secret.
CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Sanity blog (read-only). Absent = /blog is a 404. Webhook: /api/webhooks/sanity.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
SANITY_WEBHOOK_SECRET=
